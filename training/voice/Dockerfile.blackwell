# F5-TTS voice-fine-tune image for Blackwell (sm_120) GPUs — e.g. the RTX 5090 (M9).
#
# The voice trainers stay out of the light `cuda` wheel (same policy as vLLM / LLaMA-Factory),
# so this is their image. It bundles the canonical F5-TTS trainer (`f5-tts_finetune-cli` +
# `f5-tts_prepare_csv_wavs`) and Resemblyzer (the M9 A/B speaker encoder), on a Blackwell-capable
# cu128 torch.
#
# Why cu128: F5-TTS pulls a default torch that only supports up to sm_90 (Ada/Hopper) and refuses
# to run on a 5090 ("sm_120 is not compatible"). torch 2.7.1+cu128 is the first release with
# Blackwell support — install it *first* so F5-TTS (which only needs torch>=2.0) keeps it instead
# of pulling a cu124 wheel. A 16 GB RTX 4080 (sm_89) can drop the cu128 layer and `pip install
# f5-tts` on the stock torch.
#
#   docker build -f training/voice/Dockerfile.blackwell -t personavoice/voice-trainer:blackwell .
#
# Then fine-tune / A/B with the repo + an HF cache volume mounted (so the F5 base checkpoint and
# the Resemblyzer weights download once); PYTHONPATH exposes the repo's pure eval helpers:
#   docker run --rm --gpus all -v "$PWD":/workspace -w /workspace \
#     -e PYTHONPATH=/workspace/src \
#     -v persona-voice_hf-cache:/models/hf \
#     personavoice/voice-trainer:blackwell \
#     bash training/voice/run_finetune.sh
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
LABEL org.opencontainers.image.title="Persona-Voice — Blackwell voice trainer" \
      org.opencontainers.image.description="F5-TTS voice fine-tune + Resemblyzer A/B, patched for sm_120 (RTX 5090)" \
      org.opencontainers.image.source="https://github.com/olegasd123/persona-voice" \
      com.personavoice.app="persona-voice" \
      com.personavoice.component="voice-trainer"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models/hf

# Python 3.12 (deadsnakes) + audio runtime (libsndfile/ffmpeg) + a C toolchain (Resemblyzer's
# webrtcvad builds from source on cp312) + git (F5 fetches configs/weights from the Hub).
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        build-essential libsndfile1 ffmpeg git \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && rm -rf /var/lib/apt/lists/*

# Blackwell-capable torch (sm_120) first. --extra-index-url keeps PyPI for torch's non-torch
# transitive deps; without it --index-url would replace PyPI and resolution fails.
RUN python3.12 -m pip install --upgrade pip \
    && python3.12 -m pip install \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        torch==2.7.1+cu128 torchaudio==2.7.1+cu128

# The F5-TTS trainer (f5-tts_finetune-cli + the f5_tts.train.datasets.prepare_csv_wavs module)
# and the M9 A/B speaker encoder. f5-tts only needs torch>=2.0, so it keeps the cu128 torch above.
RUN python3.12 -m pip install "f5-tts" resemblyzer

# Resemblyzer → webrtcvad → `import pkg_resources`, but setuptools>=81 dropped the bundled
# pkg_resources, leaving only Ubuntu's copy which is broken on Python 3.12 (calls the removed
# pkgutil.ImpImporter). Pin setuptools<81 so a working pkg_resources is importable; verify at
# build time so a regression fails the build, not the first A/B.
RUN python3.12 -m pip install "setuptools<81" \
    && python3.12 -c "import resemblyzer; print('resemblyzer import OK')"

WORKDIR /workspace
CMD ["bash"]
