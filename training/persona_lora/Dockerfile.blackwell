# LLaMA-Factory trainer image for Blackwell (sm_120) GPUs — e.g. the RTX 5090.
#
# The stock `hiyouga/llamafactory:latest` ships torch 2.6.0+cu124, which only supports up to
# sm_90 (Ada/Hopper) and refuses to run on an RTX 5090 ("sm_120 is not compatible"). It also
# ships without bitsandbytes (needed for 4-bit QLoRA). This overlay swaps in the cu128 torch
# wheels + a Blackwell-capable bitsandbytes so the QLoRA path runs on sm_120.
#
# A 16 GB RTX 4080 (sm_89) runs the stock image as-is — this overlay is only for newer cards.
#
#   docker build -f training/persona_lora/Dockerfile.blackwell \
#     -t personavoice/llamafactory:blackwell .
#
# Then train with it (mounting the repo + sharing the vLLM HF cache):
#   docker run --rm --gpus all -v "$PWD":/workspace -w /workspace \
#     -v persona-voice_hf-cache:/root/.cache/huggingface \
#     personavoice/llamafactory:blackwell \
#     llamafactory-cli train models/adapters/<persona>/<persona>_lora.cuda.yaml
# torch 2.7.1 is the first release with Blackwell (sm_120) support; it stays close to the image's
# 2.6.0 to minimize LLaMA-Factory dependency drift. `--upgrade` is required — without it pip sees
# torch already installed and skips the swap. bitsandbytes >=0.47 ships sm_120 4-bit kernels.
FROM hiyouga/llamafactory:latest
# Exact +cu128 wheels from the PyTorch index; PyPI stays available (--extra-index-url) for torch's
# non-torch transitive deps (triton, ...). Without --extra-index-url, --index-url replaces PyPI and
# resolution fails; without --upgrade, pip keeps the image's pre-installed torch 2.6.0.
RUN pip install --no-cache-dir --upgrade \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        torch==2.7.1+cu128 torchvision==0.22.1+cu128 torchaudio==2.7.1+cu128 \
 && pip install --no-cache-dir --upgrade "bitsandbytes>=0.47"
