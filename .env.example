# Copy to `.env` and adjust. Loaded by personavoice.server.config.

# Which backend to run. `mac` = M4 Max dev (MLX / Ollama / Kokoro),
# `cuda` = RTX 4080 prod (faster-whisper / vLLM / Chatterbox).
BACKEND=mac

# Where config lives (backends + personas). Defaults to ./config relative to repo root.
PERSONAVOICE_CONFIG_DIR=config

# Where downloaded models / weights are cached.
PERSONAVOICE_MODELS_DIR=models

# Where cloned voices + their manifest live. Defaults to <models>/clones if unset.
PERSONAVOICE_CLONES_DIR=models/clones

# Where fine-tuned voices + their manifest live. Defaults to <models>/finetuned if unset.
PERSONAVOICE_FINETUNED_DIR=models/finetuned

# Where per-user conversation memory lives. Defaults to <models>/memory if unset.
PERSONAVOICE_MEMORY_DIR=models/memory
# Optional Fernet key to encrypt stored conversations at rest. Empty = plaintext (dev).
# Generate one with `personavoice-memory --gen-key` (needs the `memory` extra).
PERSONAVOICE_MEMORY_KEY=

# Default persona for the live agent when the client sets no job/room metadata.
# Falls back to the first registered persona if unset or unknown.
PERSONAVOICE_PERSONA=companion

# Multi-user custom personas (N3): writable JSON store for personas users create at runtime.
# Defaults to <models>/user_personas.json if unset. Cap how many each user may create.
PERSONAVOICE_USER_PERSONAS=models/user_personas.json
PERSONAVOICE_MAX_USER_PERSONAS=50

# --- LLM serving endpoints ------------------------------------------------------------
# Mac dev uses LM Studio's OpenAI-compatible server by default.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Alternative Mac LLM backend (set adapter: ollama in config/backends/mac.yaml).
OLLAMA_BASE_URL=http://localhost:11434

# --- CUDA backend per-stage overrides (config/backends/cuda.yaml) ----------------------
# cuda.yaml defaults to the dockerized prod stack: vLLM (LLM) + Chatterbox (TTS). The brain is
# served by the vLLM container (`docker compose up -d vllm`, reachable at :8000):
PERSONAVOICE_LLM_ADAPTER=vllm
PERSONAVOICE_LLM_BASE_URL=http://localhost:8000/v1
PERSONAVOICE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ   # 4080-safe AWQ; matches docker-compose.yml
# vLLM serving knobs interpolated by docker-compose.yml. The committed defaults fit a 16 GB
# 4080 (AWQ 4-bit, 0.45 VRAM); a bigger card can serve the unquantized model + a larger cache:
#   VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct   # unquantized (needs >16 GB); must match LLM_MODEL above
#   VLLM_GPU_UTIL=0.6
# Served LoRA adapters for the custom-persona /loras picker (vLLM only). Same `name=path` form
# docker-compose.lora.yml passes to `--lora-modules`; PERSONAVOICE_LORA_MODULES overrides it for
# non-compose deployments. Empty on Mac/LM Studio (a LoRA is merged into the base at train time).
#   VLLM_LORA_MODULES=hr_interviewer=/models/adapters/hr_interviewer
PERSONAVOICE_LORA_MODULES=
# A Windows-native dev box may also pin TTS explicitly:
#   PERSONAVOICE_TTS_ADAPTER=chatterbox   # or kokoro (fast, no clone)
# To serve the brain from LM Studio instead of vLLM (no container), set:
#   PERSONAVOICE_LLM_ADAPTER=lmstudio
#   PERSONAVOICE_LLM_BASE_URL=http://localhost:1234/v1
#   PERSONAVOICE_LLM_MODEL=qwen/qwen2.5-7b-instruct   # the id `lms ps` reports

# --- Server ---------------------------------------------------------------------------
PERSONAVOICE_HOST=0.0.0.0
PERSONAVOICE_PORT=8080
# Bearer token required by the server API / token server (set a strong value in prod;
# empty disables auth in dev).
PERSONAVOICE_API_TOKEN=
# How long minted LiveKit join tokens stay valid, in seconds (default 1 hour).
PERSONAVOICE_TOKEN_TTL=3600

# --- Server hardening -----------------------------------------------------------
# Strict mode: refuse to start the token server if the security audit finds a blocking issue
# (e.g. no API token). Leave empty/0 for dev; set to 1 in prod.
PERSONAVOICE_REQUIRE_AUTH=
# Optional TLS for the token server (set BOTH for https). Prefer terminating TLS at a reverse
# proxy in prod; these are for a standalone deployment.
PERSONAVOICE_TLS_CERT=
PERSONAVOICE_TLS_KEY=
# Rate limit the /token + /personas endpoints (token bucket, per client IP). 0 = disabled (dev).
PERSONAVOICE_RATE_LIMIT_RPS=
PERSONAVOICE_RATE_LIMIT_BURST=

# --- Session options & safety ---------------------------------------------------
# Per-conversation overrides (voice / CEFR level / demeanor) ride the room/job metadata and
# data-message rail — no env needed; the client chooses them. Moderation is the one toggle:
# Input/output guard around the LLM turn. Empty = off (no-op, behavior unchanged). Set to
# `keyword` to enable the dependency-free rule guard (crisis-on-input + bounded `rude` output).
# Recommended once the `rude` demeanor is exposed to real users.
PERSONAVOICE_MODERATION=
# Per-utterance emotion (Feature F): when on, the persona is asked to prefix each reply with a
# `[emotion]` tag (neutral/happy/excited/calm/sad/serious/warm/curious/sympathetic) that the
# pipeline strips and applies to the voice for that turn. Audible only on a cloning backend
# (Chatterbox `exaggeration`); Kokoro/preset-only backends ignore it. Empty/false = off.
PERSONAVOICE_DYNAMIC_EMOTION=

# --- Tool / function calling (Feature D) ----------------------------------------
# A persona opts into tools via its `tools:` field; the LLM is only sent tool schemas when the
# persona lists at least one (so tool-free personas are unaffected). Routed on the OpenAI-compatible
# backends only — vLLM needs `--enable-auto-tool-choice --tool-call-parser <model parser>`; other
# backends ignore the schemas and answer without tools. These two bound the per-turn tool loop:
# the max model↔tool round-trips before a plain answer is forced, and the per-tool execution
# timeout (seconds). Defaults 4 / 10; raise the timeout only for genuinely slow tools.
PERSONAVOICE_TOOL_MAX_ITERS=4
PERSONAVOICE_TOOL_TIMEOUT=10

# --- Voice library / enrollment (POST /voices/clone) ----------------------------
# Cap clones per deployment and the max uploaded sample size (bytes) for the enroll endpoint.
PERSONAVOICE_MAX_CLONES=50
PERSONAVOICE_MAX_CLONE_BYTES=10485760
# Bundled seed voices enrolled by `personavoice-seed-voices`. Defaults to assets/seed_voices.
PERSONAVOICE_SEED_VOICES_DIR=assets/seed_voices

# --- Observability --------------------------------------------------------------
# Log level (DEBUG|TRACE|INFO|WARNING|ERROR) and format (text|json) for the agent / token server.
# TRACE (between DEBUG and INFO) adds the full LLM request body and reassembled response (plus any
# tool calls/results) on top of INFO, without DEBUG's library-wide noise — dumped to the worker's
# log, i.e. the terminal running run-cuda. Verbose and unredacted: a debugging aid, not for prod.
PERSONAVOICE_LOG_LEVEL=INFO
PERSONAVOICE_LOG_FORMAT=text

# Prometheus /metrics. The token server always exposes GET /metrics (alongside /healthz); it
# serves an empty body unless the optional exporter is installed (`pip install -e '.[metrics]'`,
# already baked into the CUDA server image). The live agent records per-turn latency/outcome
# counters there. The agent worker and the token server are usually SEPARATE processes, so to see
# the agent's turn metrics on the token server's /metrics, point BOTH at one shared, writable
# directory and prometheus_client aggregates them. Leave unset to have each process export only
# its own metrics (e.g. scrape the worker directly). Must be exported before the process starts.
# PROMETHEUS_MULTIPROC_DIR=./models/metrics

# --- Concurrency / admission control --------------------------------------------
# Max conversations one agent worker admits at once. The default of 1 is the safe number for a
# single GPU: a second concurrent caller runs in a second process that loads its own STT+TTS copy
# and OOMs a 16 GB card. Scale out by running more workers (LiveKit balances across them) rather
# than raising this. Over-capacity callers are turned away (counted in sessions_rejected_total);
# the live count is exposed on /healthz (sessions_active / sessions_max) and /metrics
# (personavoice_sessions_*).
PERSONAVOICE_MAX_SESSIONS=1

# How the worker runs each conversation job. `thread` keeps every job in the worker process so the
# models prewarmed at startup are reused across calls — no per-conversation model reload, so a new
# call (even right after ending one) is warm immediately. `process` (LiveKit's default off Windows)
# isolates each job in its own subprocess that reloads all models every conversation, which on a
# single-session worker means every call pays the cold start. Defaults to `thread` on the Mac dev
# backend and `process` elsewhere (where per-job isolation is validated). Override per deployment.
# PERSONAVOICE_JOB_EXECUTOR=thread

# An over-capacity caller who slips past the load gate is briefly admitted and hears a "busy" clip
# (then is disconnected) instead of sitting in a silent room. By default a synthesized telephone
# busy tone is played (no model load); point this at a WAV to play your own spoken "all lines busy"
# recording instead. Unset / unreadable → the synthesized tone.
# PERSONAVOICE_BUSY_CLIP=./config/busy.wav
# Seconds advised to a turned-away caller before retrying — used in the busy data message and the
# token server's Retry-After header (see PERSONAVOICE_ADMISSION_503). Default 10, floored at 1.
PERSONAVOICE_BUSY_RETRY_AFTER=10

# Optional token-server early gate: when on, POST/GET /token returns 503 + Retry-After once the
# worker's live gauge reports full, so a client never connects only to be turned away in-room. It's
# an optimization on top of the worker's load gate (it has a read->mint->connect race) and needs a
# shared PROMETHEUS_MULTIPROC_DIR so the token server can read the worker's count; it fails open
# (mints) when the count is unreadable. Off by default. (1/true/yes/on to enable.)
PERSONAVOICE_ADMISSION_503=1

# --- Latency tuning -------------------------------------------------------------
# The live agent prewarms STT/LLM/TTS at worker startup (loads weights + runs one dummy
# inference each) so the first real turn isn't stuck behind a ~40 s cold start. This caps how
# long that prewarm may take before LiveKit kills the runner — must exceed first-run model
# downloads (default 600 s; raise it on a slow link, lower it once weights are cached).
PERSONAVOICE_PREWARM_TIMEOUT=600
# vLLM (or LM Studio) may still be loading its model when the agent starts right after
# `docker compose up -d vllm`. The LLM warm-up retries until the server answers or this many
# seconds elapse (default 180), so the worker only starts taking calls once the brain is ready.
PERSONAVOICE_LLM_WARMUP_WAIT=180
# TTS chunk sizing for streaming. FIRST_CHUNK_CHARS (unset by default) lets the first spoken
# chunk break early at a clause boundary to cut time-to-first-audio; MAX_CHUNK_CHARS caps a
# run-on sentence.
PERSONAVOICE_TTS_MAX_CHUNK_CHARS=240
PERSONAVOICE_TTS_FIRST_CHUNK_CHARS=
# VAD endpointing knobs (live agent). Shorter min-silence = snappier turns but more risk of
# cutting the user off. Durations are milliseconds; activation threshold is 0..1.
PERSONAVOICE_VAD_MIN_SILENCE_MS=
PERSONAVOICE_VAD_MIN_SPEECH_MS=
PERSONAVOICE_VAD_PREFIX_PADDING_MS=
PERSONAVOICE_VAD_ACTIVATION_THRESHOLD=
# Semantic endpointing (Feature G): layered on top of the VAD above. When on, an utterance that
# reads as a mid-thought pause (trailing conjunction/preposition/article, or a filler like "um")
# is held and merged with the next one instead of triggering its own reply — so "I think… *pause*
# …it's fine" is one turn, not two. GRACE_MS bounds a misjudged hold: if no continuation arrives
# the held text is answered after this long (default 1500 ms). Empty/false = off (pure-VAD).
PERSONAVOICE_SEMANTIC_ENDPOINTING=
PERSONAVOICE_ENDPOINTING_GRACE_MS=1500

# --- LiveKit ------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Hugging Face (for gated/private model downloads) ---------------------------------
HF_TOKEN=
